{
  "name": "storyboard-webportal",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "pack:nuget": "node tools/pack-webportal-nuget.mjs",
    "verify:contracts": "node tools/verify-contract-package.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@jojo-d-little/storyboard-contracts": "0.1.0-experimental.4",
    "pixi.js": "^8.20.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
