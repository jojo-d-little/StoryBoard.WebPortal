{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feature-catalog.v1.schema.json",
  "title": "Feature Catalog v1",
  "type": "object",
  "required": [
    "meta",
    "features"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "configVersion"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "configVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "category",
          "description"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
