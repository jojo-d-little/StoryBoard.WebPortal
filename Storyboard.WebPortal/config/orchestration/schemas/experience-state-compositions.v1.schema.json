{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "experience-state-compositions.v1.schema.json",
  "title": "Experience State Compositions v1",
  "type": "object",
  "required": [
    "meta",
    "stateProfiles"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "configVersion"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "configVersion": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "stateProfiles": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^(Bootstrapping|SignedOut|SignedIn|SessionActive|SessionDisconnected)$": {
          "type": "object",
          "required": [
            "profiles"
          ],
          "properties": {
            "defaultProfile": {
              "type": "string"
            },
            "profiles": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {
                "type": "object",
                "required": [
                  "slotAssignments"
                ],
                "properties": {
                  "slotAssignments": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "slotKey",
                        "mode"
                      ],
                      "properties": {
                        "slotKey": {
                          "type": "string",
                          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
                        },
                        "featureKey": {
                          "type": "string",
                          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
                        },
                        "mode": {
                          "type": "string",
                          "enum": [
                            "visible",
                            "hidden",
                            "collapsed",
                            "disabled",
                            "readonly"
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "preferredInputFocus": {
                    "type": "object",
                    "required": [
                      "featureKey"
                    ],
                    "properties": {
                      "featureKey": {
                        "type": "string",
                        "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
                      },
                      "focusedInputId": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
