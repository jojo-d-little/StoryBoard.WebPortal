{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyboard.local/schemas/portal-modes.v1.schema.json",
  "title": "StoryBoard Portal modes",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "defaultModeKey", "modes"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "configVersion"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "configVersion": { "type": "string" }
      }
    },
    "defaultModeKey": { "type": "string", "minLength": 1 },
    "modes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["formFactorKey", "skeletonLayoutKey", "compositionProfileKey"],
        "properties": {
          "formFactorKey": { "type": "string", "minLength": 1 },
          "skeletonLayoutKey": { "type": "string", "minLength": 1 },
          "compositionProfileKey": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
