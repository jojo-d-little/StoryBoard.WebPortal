{
  "meta": {
    "schemaVersion": "1.0",
    "configVersion": "1.0.0"
  },
  "devToolsDefaults": {
    "pollIntervalMs": 750,
    "heartbeatEveryNPolls": 100,
    "echoOutputRetentionLines": 400
  },
  "diagnosticsProfiles": {
    "defaultProfile": "Normal",
    "profiles": {
      "Asset Acquisition": {
        "label": "Asset Acquisition",
        "description": "Trace renderer asset lookup, cache hits and misses, Host fetches, and hydration results or failures.",
        "captureSources": ["assets", "renderer", "transport"],
        "displayCategories": ["asset-cache", "session-render", "transport"],
        "heartbeatEveryNPolls": 100,
        "logAllWarnings": false,
        "logAllErrors": false
      },
      "Session Lifecycle": {
        "label": "Session Lifecycle",
        "description": "Trace authentication, game discovery, and session start, join, and leave operations with their Host requests and responses.",
        "captureSources": ["authentication", "discovery", "session", "transport"],
        "displayCategories": ["auth", "discovery", "session", "host-operation", "transport"],
        "heartbeatEveryNPolls": 100,
        "logAllWarnings": false,
        "logAllErrors": false
      },
      "Normal": {
        "label": "Normal",
        "description": "Routine gameplay trace: submitted commands, command responses, session output, and data-bearing delta polls, plus all warnings and errors.",
        "captureSources": ["session", "commands", "polling"],
        "displayCategories": ["command", "session-echo", "session-delta"],
        "heartbeatEveryNPolls": 100,
        "logAllWarnings": true,
        "logAllErrors": true
      },
      "Verbose": {
        "label": "Verbose",
        "description": "All current Portal trace sources and categories, including warnings and errors, with a faster heartbeat for active investigation.",
        "captureSources": ["authentication", "discovery", "session", "transport", "commands", "polling", "renderer", "presentation", "audio", "assets", "orchestration", "failure"],
        "displayCategories": ["auth", "command", "contracts", "discovery", "host-operation", "transport", "session", "session-delta", "session-echo", "session-render", "session-audio", "asset-cache", "presentation-cues", "movement-cues", "timing-sync", "state", "renderer-scene", "renderer-asset", "renderer-frame", "renderer-lifecycle"],
        "heartbeatEveryNPolls": 100,
        "logAllWarnings": true,
        "logAllErrors": true
      }
    }
  },
  "audioDefaults": {
    "requireUserGestureToUnlock": true,
    "lanes": {
      "sfx": {
        "muted": false,
        "volumePercent": 100
      },
      "ambient": {
        "muted": false,
        "volumePercent": 100
      }
    }
  },
  "roomTransitionDefaults": {
    "enabled": true,
    "cueCategory": "RoomTransition",
    "cueEffectKeyOverridesByTravelDirection": {
      "Up": "room.transition.fade.cross.medium",
      "Down": "room.transition.fade.cross.medium"
    },
    "cueEffectKey": "room.transition.slide.directional.slow",
    "respectTravelDirection": true,
    "fallbackDurationMs": 840
  },
  "waypointDefaults": {
    "pointPlacementCueEffectKey": "waypoint.point.place.rings.medium"
  },
  "uiCommandVerbs": {
    "waypointSubmit": "submitwaypoints",
    "pointClicked": "pointclicked"
  }
}
